# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- Mode -------------------------------------------------------------------
# VPS: unlaunched.dev. Local: localhost (anything.localhost resolves to 127.0.0.1).
BASE_DOMAIN=unlaunched.dev
# Local mode only: "standalone" runs a local edge Traefik. Leave empty on the VPS.
COMPOSE_PROFILES=
# Local mode only: host port for the standalone edge (bootstrap picks 8800).
EDGE_PORT=
# What Matrix clients are told to connect to (http://matrix.localhost:8800 locally).
MATRIX_PUBLIC_URL=https://matrix.unlaunched.dev

# --- Harness ----------------------------------------------------------------
# claude or fake
HARNESS=claude
# Memory cap for the office container: the service and every worker it runs.
OFFICE_MEM_LIMIT=1536m
# From `claude setup-token` (one-year token for your subscription).
CLAUDE_CODE_OAUTH_TOKEN=

# --- Deployer ---------------------------------------------------------------
# Shared secret office sends in the X-Deployer-Secret header. `openssl rand -hex 32`.
DEPLOYER_SECRET=
# github (fetch from the org) or local (fetch from bare repos in the git-source volume)
DEPLOYER_GIT_SOURCE=github
GITHUB_ORG=unlaunched
# Fine-grained, resource owner unlaunched, all repositories, read-only: Contents and Actions.
DEPLOYER_GITHUB_TOKEN=
# ghcr.io only accepts classic tokens: a classic token with just read:packages,
# and the GitHub username that owns it.
DEPLOYER_REGISTRY_USER=
DEPLOYER_REGISTRY_TOKEN=
# true on the VPS. Local mode has no CI, so false.
DEPLOYER_REQUIRE_CHECKS=true
# Memory caps in MB.
DEPLOYER_SERVICE_MEM_CAP_MB=512
DEPLOYER_PROJECT_MEM_CAP_MB=1024

# --- Matrix -----------------------------------------------------------------
OFFICE_MATRIX_USER=@office:matrix.unlaunched.dev
# Generated by bootstrap; `just matrix-office-account` creates the account with it.
OFFICE_MATRIX_PASSWORD=
